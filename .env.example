# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Session Configuration
SESSION_SECRET=your-session-secret-key-change-this-in-production

# Server Configuration
PORT=3000
NODE_ENV=development

# Debug options
DEBUG=false

# SMS API Configuration (Optional)
SMS_USER_ID=your_sms_user_id
SMS_AUTH_KEY=your_sms_auth_key
SMS_CALL_NUMBER=your_phone_number
SMS_MODE=Test  # Test or Real
SMS_API_URL=http://www.sms9.co.kr/authSendApi/authSendApi_UTF8.php

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent

# External Links Configuration
NAVER_BOOKING_URL=https://booking.naver.com/booking/13/bizes/844951
NAVER_BLOG_TUITION_URL=https://blog.naver.com/edenschool/223955303630

# CDN Configuration
