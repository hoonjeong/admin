<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>문자 발송 - 이든배움국어학원 관리자</title>
    <%- include('../partials/styles') %>
    <style>
        .main-container {
            padding: 30px;
        }
        .section-card {
            background: white;
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }
        .section-title {
            color: #333;
            font-weight: bold;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #667eea;
        }
        .class-selector {
            margin-bottom: 20px;
        }
        .class-radio {
            margin-right: 15px;
        }
        .student-table {
            background: white;
            border-radius: 10px;
            overflow: hidden;
        }
        .student-table thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        .student-table tbody tr:hover {
            background: #f8f9fa;
        }
        .message-textarea {
            width: 100%;
            min-height: 150px;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            padding: 10px;
            resize: vertical;
        }
        .memo-textarea {
            width: 100%;
            min-height: 300px;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            padding: 10px;
            resize: vertical;
        }
        .recent-message-box {
            background: #f8f9fa;
            border-radius: 5px;
            padding: 15px;
            margin-top: 10px;
        }
        .recent-message-time {
            color: #6c757d;
            font-size: 0.9em;
            margin-bottom: 5px;
        }
        .recent-message-content {
            white-space: pre-wrap;
            word-break: break-word;
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #5a67d8 0%, #68428e 100%);
        }
        .empty-state {
            text-align: center;
            padding: 40px;
            color: #999;
        }
        .checkbox-cell {
            width: 40px;
            text-align: center;
        }
        .student-table thead th label {
            margin-bottom: 0;
            font-weight: bold;
            user-select: none;
        }
        .student-table thead th input[type="checkbox"] {
            vertical-align: middle;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="main-container">
        <div class="row">
            <div class="col-md-8">
                <div class="section-card">
                    <h3 class="section-title">문자 발송</h3>
                    
                    <!-- 반 선택 -->
                    <div class="class-selector">
                        <h5>담당반 선택</h5>
                        <div class="d-flex flex-wrap">
                            <% if (classes && classes.length > 0) { %>
                                <% classes.forEach(function(classItem, index) { %>
                                <div class="class-radio">
                                    <input type="radio" 
                                           class="form-check-input" 
                                           id="class_<%= classItem.id %>" 
                                           name="selectedClass" 
                                           value="<%= classItem.id %>"
                                           <%= index === 0 ? 'checked' : '' %>>
                                    <label class="form-check-label" for="class_<%= classItem.id %>">
                                        <%= classItem.name %> (<%= classItem.studentCount %>명)
                                    </label>
                                </div>
                                <% }); %>
                            <% } else { %>
                                <p class="text-muted">담당반이 없습니다.</p>
                            <% } %>
                        </div>
                    </div>

                    <!-- 학생 목록 -->
                    <div id="studentListContainer">
                        <h5>수신자 선택</h5>
                        <div class="table-responsive">
                            <table class="table student-table">
                                <thead>
                                    <tr>
                                        <th>학생이름</th>
                                        <th class="checkbox-cell"></th>
                                        <th>
                                            <input type="checkbox" class="form-check-input me-2" id="selectAllStudentsCheck" onclick="selectAllStudents()">
                                            <label for="selectAllStudentsCheck" style="cursor: pointer;">학생 전체선택</label>
                                        </th>
                                        <th class="checkbox-cell"></th>
                                        <th>
                                            <input type="checkbox" class="form-check-input me-2" id="selectAllParentsCheck" onclick="selectAllParents()">
                                            <label for="selectAllParentsCheck" style="cursor: pointer;">학부모 전체선택</label>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="studentTableBody">
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">반을 선택해주세요.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- 메시지 입력 -->
                    <div class="mt-4">
                        <h5>메시지 작성</h5>
                        <textarea id="messageContent" class="message-textarea" placeholder="전송할 메시지를 입력하세요..."></textarea>
                        <div class="mt-2 text-end text-muted">
                            <span id="messageLength">0</span> / 90 bytes (SMS)
                        </div>
                    </div>

                    <!-- 발송 버튼 -->
                    <div class="mt-4 text-center">
                        <button class="btn btn-primary btn-lg" onclick="sendSMS()">
                            <i class="bi bi-send"></i> 문자 전송
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="section-card">
                    <h3 class="section-title">메모</h3>
                    <textarea id="memoContent" class="memo-textarea" placeholder="자주 사용하는 메시지를 저장해두세요..."><%= memo %></textarea>
                    <div class="mt-3 text-center">
                        <button class="btn btn-primary" onclick="saveMemo()">
                            <i class="bi bi-save"></i> 메모 저장
                        </button>
                    </div>
                </div>
                
                <div class="section-card mt-3">
                    <h3 class="section-title">최근 메시지</h3>
                    <div id="recentMessageContainer">
                        <p class="text-muted">번호를 선택하면 최근 발송 메시지가 표시됩니다.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // 페이지 로드 시 첫 번째 반의 학생 목록 불러오기
        $(document).ready(function() {
            const firstClass = $('input[name="selectedClass"]:checked');
            if (firstClass.length > 0) {
                loadStudents(firstClass.val());
            }

            // 반 선택 변경 이벤트
            $('input[name="selectedClass"]').change(function() {
                loadStudents($(this).val());
            });

            // 메시지 길이 체크
            $('#messageContent').on('input', function() {
                const message = $(this).val();
                const bytes = new Blob([message]).size;
                $('#messageLength').text(bytes);
                
                if (bytes > 90) {
                    $('#messageLength').parent().removeClass('text-muted').addClass('text-danger');
                } else {
                    $('#messageLength').parent().removeClass('text-danger').addClass('text-muted');
                }
            });
            
            // 체크박스 선택 이벤트 - 최근 메시지 표시
            $(document).on('change', '.student-phone, .parent-phone', function() {
                // 새로 체크된 경우에만 최근 메시지 로드
                if ($(this).is(':checked')) {
                    const phone = $(this).val();
                    const name = $(this).data('name');
                    const type = $(this).data('type');
                    
                    // 학부모의 경우 "학부모님"을 추가
                    const displayName = type === 'parent' ? name + ' 학부모님' : name + '님';
                    
                    // Loading recent message
                    if (phone && phone !== '-' && phone !== '') {
                        loadRecentMessage(phone, displayName);
                    }
                }
                
                // 전체선택 체크박스 상태 업데이트
                updateSelectAllCheckboxes();
            });
        });

        // 학생 목록 불러오기
        function loadStudents(classId) {
            $.ajax({
                url: '/teacher/api/class-students/' + classId,
                method: 'GET',
                success: function(response) {
                    if (response.success && response.students.length > 0) {
                        let html = '';
                        response.students.forEach(function(student) {
                            const hasStudentPhone = student.sphone && student.sphone !== '-' && student.sphone !== '' && student.sphone !== null;
                            const hasParentPhone = student.pphone && student.pphone !== '-' && student.pphone !== '' && student.pphone !== null;
                            
                            html += `
                                <tr>
                                    <td>${student.name}</td>
                                    <td class="checkbox-cell">
                                        ${hasStudentPhone ? 
                                            `<input type="checkbox" 
                                                    class="form-check-input student-phone" 
                                                    value="${student.sphone}"
                                                    data-phone="${student.sphone}"
                                                    data-name="${student.name}"
                                                    data-type="student">` : ''}
                                    </td>
                                    <td>${student.sphone || '-'}</td>
                                    <td class="checkbox-cell">
                                        ${hasParentPhone ? 
                                            `<input type="checkbox" 
                                                    class="form-check-input parent-phone" 
                                                    value="${student.pphone}"
                                                    data-phone="${student.pphone}"
                                                    data-name="${student.name}"
                                                    data-type="parent">` : ''}
                                    </td>
                                    <td>${student.pphone || '-'}</td>
                                </tr>
                            `;
                        });
                        $('#studentTableBody').html(html);
                        
                        // 전체선택 체크박스 초기화
                        $('#selectAllStudentsCheck').prop('checked', false);
                        $('#selectAllParentsCheck').prop('checked', false);
                    } else {
                        $('#studentTableBody').html('<tr><td colspan="5" class="text-center text-muted">학생이 없습니다.</td></tr>');
                    }
                },
                error: function() {
                    alert('학생 목록을 불러오는데 실패했습니다.');
                }
            });
        }

        // 학생 전체 선택
        function selectAllStudents() {
            const checkboxes = $('.student-phone');
            if (checkboxes.length === 0) {
                $('#selectAllStudentsCheck').prop('checked', false);
                return;
            }
            
            const shouldCheck = $('#selectAllStudentsCheck').is(':checked');
            checkboxes.prop('checked', shouldCheck);
            
            // 체크 상태 변경 후 최근 메시지 확인
            if (shouldCheck) {
                const firstChecked = $('.student-phone:checked').first();
                if (firstChecked.length > 0) {
                    const phone = firstChecked.val();
                    const name = firstChecked.data('name');
                    const displayName = name + '님';
                    if (phone && phone !== '-' && phone !== '') {
                        loadRecentMessage(phone, displayName);
                    }
                }
            }
        }

        // 학부모 전체 선택
        function selectAllParents() {
            const checkboxes = $('.parent-phone');
            if (checkboxes.length === 0) {
                $('#selectAllParentsCheck').prop('checked', false);
                return;
            }
            
            const shouldCheck = $('#selectAllParentsCheck').is(':checked');
            checkboxes.prop('checked', shouldCheck);
            
            // 체크 상태 변경 후 최근 메시지 확인
            if (shouldCheck) {
                const firstChecked = $('.parent-phone:checked').first();
                if (firstChecked.length > 0) {
                    const phone = firstChecked.val();
                    const name = firstChecked.data('name');
                    const displayName = name + ' 학부모님';
                    if (phone && phone !== '-' && phone !== '') {
                        loadRecentMessage(phone, displayName);
                    }
                }
            }
        }

        // 문자 발송
        function sendSMS() {
            const phones = [];
            
            // 선택된 학생 번호 수집
            $('.student-phone:checked').each(function() {
                const phone = $(this).val();
                if (phone && phone !== '-') {
                    phones.push(phone);
                }
            });
            
            // 선택된 학부모 번호 수집
            $('.parent-phone:checked').each(function() {
                const phone = $(this).val();
                if (phone && phone !== '-') {
                    phones.push(phone);
                }
            });
            
            const message = $('#messageContent').val().trim();
            
            if (phones.length === 0) {
                alert('수신자를 선택해주세요.');
                return;
            }
            
            if (message === '') {
                alert('메시지를 입력해주세요.');
                return;
            }
            
            const bytes = new Blob([message]).size;
            const type = bytes > 90 ? 'LMS' : 'SMS';
            
            if (confirm(`${phones.length}명에게 문자를 발송하시겠습니까?\n발송 타입: ${type}`)) {
                $.ajax({
                    url: '/teacher/api/send-sms',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        phones: phones,
                        message: message,
                        type: type
                    }),
                    success: function(response) {
                        if (response.success) {
                            alert(`문자 발송 완료!\n성공: ${response.totalSent}건\n실패: ${response.totalFailed}건`);
                            $('#messageContent').val('');
                            $('.student-phone, .parent-phone').prop('checked', false);
                        } else {
                            alert('문자 발송 실패: ' + response.error);
                        }
                    },
                    error: function() {
                        alert('문자 발송 중 오류가 발생했습니다.');
                    }
                });
            }
        }

        // 메모 저장
        function saveMemo() {
            const memo = $('#memoContent').val();
            
            $.ajax({
                url: '/teacher/api/save-memo',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ memo: memo }),
                success: function(response) {
                    if (response.success) {
                        alert('메모가 저장되었습니다.');
                    } else {
                        alert('메모 저장 실패: ' + response.error);
                    }
                },
                error: function() {
                    alert('메모 저장 중 오류가 발생했습니다.');
                }
            });
        }

        // 최근 메시지 불러오기
        function loadRecentMessage(phone, displayName) {
            $.ajax({
                url: '/teacher/api/recent-message/' + phone + '/' + encodeURIComponent(displayName),
                method: 'GET',
                success: function(response) {
                    if (response.success) {
                        if (response.message) {
                            const html = `
                                <div class="recent-message-box">
                                    <h6 class="text-primary mb-2">${response.recipientName}에게 보낸 최근 메시지</h6>
                                    <div class="recent-message-time">
                                        <i class="bi bi-clock"></i> ${response.sendTime}
                                    </div>
                                    <div class="recent-message-content">${response.message}</div>
                                </div>
                            `;
                            $('#recentMessageContainer').html(html);
                        } else {
                            $('#recentMessageContainer').html(`<p class="text-muted">${displayName}에게 발송된 메시지가 없습니다.</p>`);
                        }
                    }
                },
                error: function() {
                    $('#recentMessageContainer').html('<p class="text-danger">최근 메시지를 불러오는데 실패했습니다.</p>');
                }
            });
        }
        
        // 전체선택 체크박스 상태 업데이트
        function updateSelectAllCheckboxes() {
            const studentCheckboxes = $('.student-phone');
            const parentCheckboxes = $('.parent-phone');
            
            // 학생 전체선택 체크박스 상태
            if (studentCheckboxes.length > 0) {
                const allStudentsChecked = studentCheckboxes.length === studentCheckboxes.filter(':checked').length;
                $('#selectAllStudentsCheck').prop('checked', allStudentsChecked);
            } else {
                $('#selectAllStudentsCheck').prop('checked', false);
            }
            
            // 학부모 전체선택 체크박스 상태
            if (parentCheckboxes.length > 0) {
                const allParentsChecked = parentCheckboxes.length === parentCheckboxes.filter(':checked').length;
                $('#selectAllParentsCheck').prop('checked', allParentsChecked);
            } else {
                $('#selectAllParentsCheck').prop('checked', false);
            }
        }
        
        function showPreparing() {
            alert('준비중입니다.');
        }
    </script>
</body>
</html>