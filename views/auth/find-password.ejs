<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>비밀번호 찾기 - 이든배움국어학원 관리자</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .find-container {
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding: 40px;
            width: 100%;
            max-width: 400px;
        }
        .find-header {
            text-align: center;
            margin-bottom: 30px;
        }
        .find-header h2 {
            color: #333;
            font-weight: bold;
        }
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        .btn-find {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: 12px;
            font-weight: bold;
            transition: transform 0.2s;
        }
        .btn-find:hover {
            transform: translateY(-2px);
            color: white;
        }
        .btn-back {
            background: #6c757d;
            border: none;
            color: white;
            padding: 12px;
            font-weight: bold;
        }
        .btn-back:hover {
            background: #5a6268;
            color: white;
        }
    </style>
</head>
<body>
    <div class="find-container">
        <div class="find-header">
            <h2>비밀번호 찾기</h2>
            <p class="text-muted">임시 비밀번호를 이메일로 전송합니다</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert">
            <%= error %>
        </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="alert">
            <%= success %>
        </div>
        <% } %>

        <form action="/auth/find-password" method="POST" id="findPasswordForm">
            <div class="mb-3">
                <label for="name" class="form-label">이름</label>
                <input type="text" class="form-control" id="name" name="name" required placeholder="홍길동">
            </div>
            
            <div class="mb-3">
                <label for="phone" class="form-label">전화번호</label>
                <input type="tel" class="form-control" id="phone" name="phone" required placeholder="010-1234-5678">
            </div>
            
            <div class="mb-3">
                <label for="email" class="form-label">이메일</label>
                <input type="email" class="form-control" id="email" name="email" required placeholder="example@email.com">
            </div>
            
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-find">임시 비밀번호 발송</button>
                <a href="/auth/login" class="btn btn-back">로그인 페이지로 돌아가기</a>
            </div>
        </form>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#phone').on('input', function() {
                let value = $(this).val().replace(/[^0-9]/g, '');
                if (value.length > 3 && value.length <= 7) {
                    value = value.slice(0, 3) + '-' + value.slice(3);
                } else if (value.length > 7) {
                    value = value.slice(0, 3) + '-' + value.slice(3, 7) + '-' + value.slice(7, 11);
                }
                $(this).val(value);
            });
        });
    </script>
</body>
</html>