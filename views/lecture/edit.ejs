<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - Eden Language Academy</title>
    <link href="<%= process.env.BOOTSTRAP_CSS_URL || 'https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css' %>" rel="stylesheet">
    <link rel="stylesheet" href="<%= process.env.BOOTSTRAP_ICONS_URL || 'https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css' %>">
    <style>
        .existing-files {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 10px;
        }
        .file-item {
            padding: 8px;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .file-item:last-child {
            border-bottom: none;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-12">
                <h2 class="mb-4">강의 수정</h2>
                
                <form method="POST" action="/lecture/edit/<%= lecture.id %>" enctype="multipart/form-data" id="editForm">
                    <div class="card">
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="subject" class="form-label">강의 제목 <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="subject" name="subject" 
                                       value="<%= lecture.subject %>" required>
                            </div>
                            
                            <div class="mb-3">
                                <label for="description" class="form-label">강의 설명</label>
                                <textarea class="form-control" id="description" name="description" 
                                          rows="4"><%= lecture.description || '' %></textarea>
                            </div>
                            
                            <div class="mb-3">
                                <label for="teacher" class="form-label">담당 선생님 <span class="text-danger">*</span></label>
                                <select class="form-select" id="teacher" name="teacher" required>
                                    <option value="">선생님을 선택하세요</option>
                                    <% teachers.forEach(teacher => { %>
                                        <option value="<%= teacher.name %>" 
                                                <%= lecture.teacher === teacher.name ? 'selected' : '' %>>
                                            <%= teacher.name %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                            
                            <div class="mb-3">
                                <label for="url" class="form-label">동영상 주소</label>
                                <input type="text" class="form-control" id="url" name="url" 
                                       value="<%= lecture.url || '' %>"
                                       placeholder="YouTube 또는 비디오 URL을 입력하세요">
                            </div>
                            
                            <% if (files && files.length > 0) { %>
                                <div class="mb-3">
                                    <label class="form-label">기존 첨부파일</label>
                                    <div class="existing-files">
                                        <% files.forEach(file => { %>
                                            <div class="file-item">
                                                <span>
                                                    <i class="bi bi-file-earmark"></i> <%= file.filename %>
                                                </span>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" 
                                                           name="deleteFiles" value="<%= file.id %>" 
                                                           id="delete_<%= file.id %>">
                                                    <label class="form-check-label text-danger" for="delete_<%= file.id %>">
                                                        삭제
                                                    </label>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } %>
                            
                            <div class="mb-3">
                                <label for="files" class="form-label">새 파일 첨부</label>
                                <input type="file" class="form-control" id="files" name="files" multiple>
                                <small class="text-muted">여러 파일을 선택할 수 있습니다. (최대 10개, 각 50MB 이하)</small>
                            </div>
                            
                            <div class="mb-3">
                                <label for="lectureDate" class="form-label">강의 날짜 <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="lectureDate" name="lectureDate" 
                                       value="<%= lecture.lecture_date ? new Date(lecture.lecture_date).toISOString().split('T')[0] : '' %>" 
                                       required>
                            </div>
                            
                            <div class="mb-3">
                                <label for="classId" class="form-label">수강반 <span class="text-danger">*</span></label>
                                <select class="form-select" id="classId" name="classId" required>
                                    <option value="">수강반을 선택하세요</option>
                                    <option value="0" <%= !lecture.class_id || lecture.class_id === 0 ? 'selected' : '' %>>
                                        특강
                                    </option>
                                    <% classes.forEach(cls => { %>
                                        <option value="<%= cls.id %>" 
                                                <%= lecture.class_id === cls.id ? 'selected' : '' %>>
                                            <%= cls.name %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>
                        
                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> 수정 완료
                            </button>
                            <a href="/lecture/view/<%= lecture.id %>" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> 취소
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <script src="<%= process.env.BOOTSTRAP_JS_URL || 'https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js' %>"></script>
    <script>
        // 이미 업로드된 파일 목록 저장
        let uploadedFiles = [];
        
        // 페이지 로드 시 기존 파일 목록 가져오기
        async function loadUploadedFiles() {
            try {
                const response = await fetch('/lecture/api/files');
                if (response.ok) {
                    const data = await response.json();
                    uploadedFiles = data.files || [];
                }
            } catch (error) {
                // 파일 목록 로드 실패
            }
        }
        
        // 페이지 로드 시 실행
        loadUploadedFiles();
        
        document.getElementById('files').addEventListener('change', function(e) {
            const files = e.target.files;
            if (files.length > 10) {
                alert('파일은 최대 10개까지만 첨부할 수 있습니다.');
                e.target.value = '';
                return;
            }
            
            let hasIssue = false;
            for (let i = 0; i < files.length; i++) {
                if (files[i].size > 50 * 1024 * 1024) {
                    alert('파일 크기는 50MB를 초과할 수 없습니다.');
                    hasIssue = true;
                    break;
                }
                
                // 중복 파일명 체크
                const isDuplicate = uploadedFiles.some(uploadedFile => 
                    uploadedFile.toLowerCase() === files[i].name.toLowerCase()
                );
                
                if (isDuplicate) {
                    if (!confirm(`"${files[i].name}" 파일이 이미 존재합니다. 계속 진행하시겠습니까?`)) {
                        hasIssue = true;
                        break;
                    }
                }
            }
            
            if (hasIssue) {
                e.target.value = '';
                return;
            }
        });
    </script>
</body>
</html>