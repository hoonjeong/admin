<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= student.name %> 학생 정보 - 이든배움국어학원 관리자</title>
    <%- include('../partials/styles') %>
    <style>
        .content-container {
            padding: 30px;
        }
        .student-card {
            background: white;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }
        .student-header {
            border-bottom: 2px solid #667eea;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }
        .student-name {
            color: #333;
            font-size: 28px;
            font-weight: bold;
            margin: 0;
        }
        .info-row {
            margin-bottom: 15px;
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
        }
        .info-label {
            font-weight: bold;
            color: #666;
            display: inline-block;
            width: 120px;
        }
        .info-value {
            color: #333;
        }
        .memo-section {
            margin-top: 30px;
        }
        .memo-label {
            font-weight: bold;
            color: #666;
            margin-bottom: 10px;
        }
        #memoTextarea {
            width: 100%;
            min-height: 150px;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            resize: vertical;
            font-family: inherit;
        }
        #memoTextarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        .btn-save {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 5px;
            font-weight: bold;
            margin-top: 15px;
        }
        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        .btn-save:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .btn-back {
            background: #6c757d;
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 5px;
            text-decoration: none;
        }
        .btn-back:hover {
            background: #5a6268;
            color: white;
        }
        .save-status {
            margin-left: 10px;
            font-size: 14px;
        }
        .save-status.success {
            color: #28a745;
        }
        .save-status.error {
            color: #dc3545;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="content-container">
        <div class="student-card">
            <div class="student-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="student-name"><%= student.name %></h2>
                    <a href="javascript:history.back()" class="btn-back">
                        <i class="bi bi-arrow-left"></i> 뒤로가기
                    </a>
                </div>
            </div>

            <div class="student-info">
                <div class="info-row">
                    <span class="info-label">학교:</span>
                    <span class="info-value"><%= student.school || '-' %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">학년:</span>
                    <span class="info-value">
                        <% if (student.grade && student.year) { %>
                            <%= student.grade %> <%= student.year %>년
                        <% } else { %>
                            -
                        <% } %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">학생번호:</span>
                    <span class="info-value"><%= student.sphone || '-' %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">학부모번호:</span>
                    <span class="info-value"><%= student.pphone || '-' %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">등록일:</span>
                    <span class="info-value"><%= student.insert_date %></span>
                </div>
            </div>

            <div class="memo-section">
                <div class="memo-label">메모</div>
                <textarea id="memoTextarea" placeholder="학생에 대한 메모를 작성하세요..."><%= student.memo || '' %></textarea>
                <div>
                    <button class="btn-save" onclick="saveMemo()">메모 저장</button>
                    <span class="save-status" id="saveStatus"></span>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/scripts') %>
    <script>

        function autoResize(textarea) {
            textarea.style.height = 'auto';
            textarea.style.height = textarea.scrollHeight + 'px';
        }

        const memoTextarea = document.getElementById('memoTextarea');
        memoTextarea.addEventListener('input', function() {
            autoResize(this);
        });

        window.addEventListener('load', function() {
            autoResize(memoTextarea);
        });

        function saveMemo() {
            const memo = document.getElementById('memoTextarea').value;
            const saveBtn = document.querySelector('.btn-save');
            const saveStatus = document.getElementById('saveStatus');
            
            saveBtn.disabled = true;
            saveStatus.textContent = '저장 중...';
            saveStatus.className = 'save-status';

            fetch('/admin/student/<%= student.id %>/memo', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ memo: memo })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    saveStatus.textContent = '저장되었습니다!';
                    saveStatus.className = 'save-status success';
                } else {
                    saveStatus.textContent = '저장 실패';
                    saveStatus.className = 'save-status error';
                }
            })
            .catch(error => {
                saveStatus.textContent = '저장 중 오류 발생';
                saveStatus.className = 'save-status error';
            })
            .finally(() => {
                saveBtn.disabled = false;
                setTimeout(() => {
                    saveStatus.textContent = '';
                }, 3000);
            });
        }
    </script>
</body>
</html>