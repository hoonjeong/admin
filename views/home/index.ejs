    <section class="section content-section">
        <div class="section-image scroll-reveal">
            <img src="/image/3.png" alt="마무리 이미지" style="max-width: 100%; height: auto; border-radius: 10px; margin: 0 auto; display: block;">
        </div>
    </section>

    <script>
        function scrollToNext() {
            window.scrollTo({
                top: window.innerHeight,
                behavior: 'smooth'
            });
        }

        // 향상된 스크롤 애니메이션 시스템
        const observerOptions = {
            threshold: 0.15,
            rootMargin: '0px 0px -100px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate');

                    // 선생님 카드들의 지연 애니메이션
                    if (entry.target.classList.contains('teachers-grid')) {
                        const cards = entry.target.querySelectorAll('.teacher-card');
                        cards.forEach((card, index) => {
                            setTimeout(() => {
                                card.classList.add('animate');
                            }, index * 100);
                        });
                    }

                    // 인사말 섹션의 개별 애니메이션
                    if (entry.target.classList.contains('greeting-section')) {
                        const image = entry.target.querySelector('.greeting-image');
                        const content = entry.target.querySelector('.greeting-content');

                        setTimeout(() => {
                            if (image) image.classList.add('animate');
                        }, 200);

                        setTimeout(() => {
                            if (content) content.classList.add('animate');
                        }, 400);
                    }

                    // 칠판 텍스트 애니메이션
                    if (entry.target.dataset.hasChalkboard) {
                        const chalkboardText = entry.target.querySelector('.chalkboard-text');
                        if (chalkboardText) {
                            setTimeout(() => {
                                chalkboardText.style.opacity = '1';
                                chalkboardText.style.transform = 'translate(-50%, -50%) scale(1)';
                            }, 300);
                        }
                    }

                    // 선생님 정보 애니메이션
                    if (entry.target.classList.contains('teacher-row')) {
                        const teacherInfo = entry.target.querySelector('.teacher-info');
                        if (teacherInfo) {
                            teacherInfo.style.opacity = '0';
                            teacherInfo.style.transform = 'translateY(50px)';
                            setTimeout(() => {
                                teacherInfo.style.opacity = '1';
                                teacherInfo.style.transform = 'translateY(0)';
                                teacherInfo.style.transition = 'all 0.8s ease-out';
                            }, 300);
                        }
                    }
                }
            });
        }, observerOptions);

        // 애니메이션을 적용할 모든 요소들을 관찰
        document.querySelectorAll('.section-image, .section-text, .teacher-row, .section-title, .teachers-grid, .greeting-section, .scroll-reveal').forEach(el => {
            observer.observe(el);
        });

        // 페이지 로드 시 초기 애니메이션 체크
        window.addEventListener('load', () => {
            // 이미 보이는 요소들에 대해 애니메이션 적용
            const viewportHeight = window.innerHeight;
            document.querySelectorAll('.section-title, .teachers-grid, .greeting-section, .scroll-reveal').forEach(el => {
                const rect = el.getBoundingClientRect();
                if (rect.top < viewportHeight * 0.8) {
                    el.classList.add('animate');
                }
            });
        });

        // 시스템 링크 클릭 이벤트
        document.querySelectorAll('.system-link').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const target = link.dataset.target;

                if (target === 'high-school') {
                    const highSchoolSection = document.getElementById('high-school');
                    if (highSchoolSection) {
                        highSchoolSection.scrollIntoView({ behavior: 'smooth' });
                    }
                } else if (target === 'middle-school') {
                    const middleSchoolSection = document.getElementById('middle-school');
                    if (middleSchoolSection) {
                        middleSchoolSection.scrollIntoView({ behavior: 'smooth' });
                    }
                } else if (target === 'reading') {
                    const readingSection = document.getElementById('reading');
                    if (readingSection) {
                        readingSection.scrollIntoView({ behavior: 'smooth' });
                    }
                }
            });
        });

        document.querySelectorAll('.nav-item').forEach(item => {
            item.addEventListener('click', (e) => {
                // 실제 링크가 있는 메뉴는 기본 동작을 허용
                const href = item.getAttribute('href');
                if (href && href !== '#' && !href.startsWith('#')) {
                    return; // 기본 동작 허용 (페이지 이동)
                }

                e.preventDefault();

                const target = item.dataset.target;

                if (target === 'high-school') {
                    // 상원고 전임 섹션으로 스크롤
                    const highSchoolSection = document.getElementById('high-school');
                    if (highSchoolSection) {
                        highSchoolSection.scrollIntoView({ behavior: 'smooth' });
                        document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));
                        item.classList.add('active');
                    }
                } else if (target === 'middle-school') {
                    // 상일중 전임 섹션으로 스크롤
                    const middleSchoolSection = document.getElementById('middle-school');
                    if (middleSchoolSection) {
                        middleSchoolSection.scrollIntoView({ behavior: 'smooth' });
                        document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));
                        item.classList.add('active');
                    }
                } else if (target === 'reading') {
                    // 독서교육원 섹션으로 스크롤
                    const readingSection = document.getElementById('reading');
                    if (readingSection) {
                        readingSection.scrollIntoView({ behavior: 'smooth' });
                        document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));
                        item.classList.add('active');
                    }
                } else if (item.textContent.trim() === '상담예약') {
                    alert('상담예약 기능은 준비중입니다.');
                } else if (item.textContent.trim() === '수강후기') {
                    alert('수강후기 기능은 준비중입니다.');
                } else if (item.textContent.trim() === '교습비') {
                    alert('교습비 안내 기능은 준비중입니다.');
                } else if (item.getAttribute('href').startsWith('#')) {
                    const targetId = item.getAttribute('href').substring(1);
                    const targetElement = document.getElementById(targetId);
                    if (targetElement) {
                        targetElement.scrollIntoView({ behavior: 'smooth' });
                        document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));
                        item.classList.add('active');
                    }
                }
            });
        });

        window.addEventListener('scroll', () => {
            const sections = document.querySelectorAll('.section');
            const scrollPos = window.scrollY + 100;

            sections.forEach((section, index) => {
                const top = section.offsetTop;
                const height = section.offsetHeight;

                if (scrollPos >= top && scrollPos < top + height) {
                    document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));

                    // 현재 보이는 섹션에 따라 메뉴 활성화
                    if (section.id === 'intro') {
                        const introNav = document.querySelector('.nav-item[href="#intro"]');
                        if (introNav) introNav.classList.add('active');
                    } else if (section.id === 'high-school') {
                        const highSchoolNav = document.querySelector('.nav-item[data-target="high-school"]');
                        if (highSchoolNav) highSchoolNav.classList.add('active');
                    } else if (section.id === 'middle-school') {
                        const middleSchoolNav = document.querySelector('.nav-item[data-target="middle-school"]');
                        if (middleSchoolNav) middleSchoolNav.classList.add('active');
                    } else if (section.id === 'reading') {
                        const readingNav = document.querySelector('.nav-item[data-target="reading"]');
                        if (readingNav) readingNav.classList.add('active');
                    }
                }
            });
        });

        // 드롭다운 메뉴 기능
        document.addEventListener('DOMContentLoaded', function() {
            const dropdown = document.getElementById('userDropdown');
            const dropdownMenu = document.getElementById('userDropdownMenu');

            if (dropdown && dropdownMenu) {
                dropdown.addEventListener('click', function(e) {
                    e.preventDefault();
                    dropdownMenu.classList.toggle('show');
                });

                // 외부 클릭 시 드롭다운 닫기
                document.addEventListener('click', function(e) {
                    if (!dropdown.contains(e.target) && !dropdownMenu.contains(e.target)) {
                        dropdownMenu.classList.remove('show');
                    }
                });
            }
        });

    </script>
    <%- include('../partials/header-scripts') %>
</body>
