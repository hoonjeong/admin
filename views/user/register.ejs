<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <%- include('../partials/header-styles') %>
    <style>

        .container {
            max-width: 500px;
            margin: 50px auto;
            background: white;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }

        .logo {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo img {
            max-width: 200px;
            height: auto;
        }

        h1 {
            text-align: center;
            margin-bottom: 30px;
            color: #333;
        }

        .notice {
            background: #e3f2fd;
            border: 1px solid #2196f3;
            border-radius: 5px;
            padding: 15px;
            margin-bottom: 30px;
            font-size: 14px;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #555;
        }

        .radio-group {
            display: flex;
            gap: 20px;
            margin-bottom: 15px;
        }

        .radio-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        input[type="radio"] {
            width: 16px;
            height: 16px;
        }

        .input-group {
            display: flex;
            gap: 10px;
            align-items: flex-end;
        }

        .input-group input {
            flex: 1;
        }

        input[type="text"], input[type="tel"] {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 14px;
        }

        input[type="text"]:focus, input[type="tel"]:focus {
            outline: none;
            border-color: #2196f3;
            box-shadow: 0 0 0 2px rgba(33, 150, 243, 0.2);
        }

        button {
            padding: 12px 20px;
            background: #2196f3;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            transition: background-color 0.3s;
        }

        button:hover {
            background: #1976d2;
        }

        button:disabled {
            background: #ccc;
            cursor: not-allowed;
        }

        .success {
            color: #4caf50;
            font-size: 14px;
            margin-top: 5px;
        }

        .error {
            color: #f44336;
            font-size: 14px;
            margin-top: 5px;
        }

        .hidden {
            display: none;
        }

        .back-link {
            text-align: center;
            margin-top: 20px;
        }

        .back-link a {
            color: #2196f3;
            text-decoration: none;
        }

        .back-link a:hover {
            text-decoration: underline;
        }

        #verificationStep {
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <%- include('../partials/header') %>

    <div class="container">
        <div class="logo">
            <img src="/image/logo.png" alt="이든배움국어학원">
        </div>

        <h1>회원가입</h1>

        <div class="notice">
            <strong>이든배움 홈페이지 회원가입은 재원생만 가능합니다.</strong><br>
            학원 등록시 작성했던 전화번호로 인증을 진행해주세요.
        </div>

        <form id="phoneForm">
            <div class="form-group">
                <label>전화번호 구분</label>
                <div class="radio-group">
                    <div class="radio-item">
                        <input type="radio" id="student" name="phoneType" value="student" checked>
                        <label for="student">학생번호</label>
                    </div>
                    <div class="radio-item">
                        <input type="radio" id="parent" name="phoneType" value="parent">
                        <label for="parent">학부모번호</label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="phone">전화번호</label>
                <div class="input-group">
                    <input type="tel" id="phone" name="phone" placeholder="전화번호를 입력하세요" maxlength="11" required>
                    <button type="button" id="sendCodeBtn">인증번호 발송</button>
                </div>
                <div id="phoneMessage"></div>
            </div>

            <div class="form-group hidden" id="verificationStep">
                <label for="verificationCode">인증번호</label>
                <div class="input-group">
                    <input type="text" id="verificationCode" name="verificationCode" placeholder="인증번호 6자리" maxlength="6">
                    <button type="button" id="verifyCodeBtn">인증번호 확인</button>
                </div>
                <div id="verificationMessage"></div>
            </div>
        </form>

        <div class="back-link">
            <a href="/">메인페이지로 돌아가기</a>
        </div>
    </div>

    <script>
        const sendCodeBtn = document.getElementById('sendCodeBtn');
        const verifyCodeBtn = document.getElementById('verifyCodeBtn');
        const phoneInput = document.getElementById('phone');
        const verificationCodeInput = document.getElementById('verificationCode');
        const verificationStep = document.getElementById('verificationStep');
        const phoneMessage = document.getElementById('phoneMessage');
        const verificationMessage = document.getElementById('verificationMessage');

        // 전화번호 입력 시 숫자만 허용
        phoneInput.addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
        });

        // 인증번호 입력 시 숫자만 허용
        verificationCodeInput.addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
        });

        // 인증번호 발송
        sendCodeBtn.addEventListener('click', async function() {
            const phone = phoneInput.value.trim();
            const phoneType = document.querySelector('input[name="phoneType"]:checked').value;

            if (!phone) {
                showMessage(phoneMessage, '전화번호를 입력해주세요.', 'error');
                return;
            }

            if (phone.length < 10 || phone.length > 11) {
                showMessage(phoneMessage, '올바른 전화번호를 입력해주세요.', 'error');
                return;
            }

            try {
                sendCodeBtn.disabled = true;
                sendCodeBtn.textContent = '발송 중...';

                const response = await fetch('/user/verify-phone', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        phone: phone,
                        type: phoneType
                    })
                });

                const data = await response.json();

                if (response.ok) {
                    showMessage(phoneMessage, data.message, 'success');
                    verificationStep.classList.remove('hidden');
                    startCountdown();
                } else {
                    showMessage(phoneMessage, data.error, 'error');
                    sendCodeBtn.disabled = false;
                    sendCodeBtn.textContent = '인증번호 발송';
                }
            } catch (error) {
                console.error('Error:', error);
                showMessage(phoneMessage, '오류가 발생했습니다. 다시 시도해주세요.', 'error');
                sendCodeBtn.disabled = false;
                sendCodeBtn.textContent = '인증번호 발송';
            }
        });

        // 인증번호 확인
        verifyCodeBtn.addEventListener('click', async function() {
            const code = verificationCodeInput.value.trim();

            if (!code) {
                showMessage(verificationMessage, '인증번호를 입력해주세요.', 'error');
                return;
            }

            if (code.length !== 6) {
                showMessage(verificationMessage, '인증번호는 6자리입니다.', 'error');
                return;
            }

            try {
                verifyCodeBtn.disabled = true;
                verifyCodeBtn.textContent = '확인 중...';

                const phone = phoneInput.value.trim();
                const phoneType = document.querySelector('input[name="phoneType"]:checked').value;

                const response = await fetch('/user/verify-code', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        code: code,
                        phone: phone,
                        type: phoneType
                    })
                });

                const data = await response.json();

                if (response.ok) {
                    if (data.status === 'existing') {
                        alert(data.message);
                        window.location.href = data.redirectUrl;
                    } else if (data.status === 'reactivated') {
                        alert(data.message);
                        window.location.href = data.redirectUrl;
                    } else if (data.status === 'new') {
                        showMessage(verificationMessage, data.message, 'success');
                        setTimeout(() => {
                            window.location.href = data.redirectUrl;
                        }, 1000);
                    }
                } else {
                    showMessage(verificationMessage, data.error, 'error');
                    verifyCodeBtn.disabled = false;
                    verifyCodeBtn.textContent = '인증번호 확인';
                }
            } catch (error) {
                console.error('Error:', error);
                showMessage(verificationMessage, '오류가 발생했습니다. 다시 시도해주세요.', 'error');
                verifyCodeBtn.disabled = false;
                verifyCodeBtn.textContent = '인증번호 확인';
            }
        });

        function showMessage(element, message, type) {
            element.textContent = message;
            element.className = type;
        }

        function startCountdown() {
            let countdown = 180; // 3분
            const timer = setInterval(() => {
                const minutes = Math.floor(countdown / 60);
                const seconds = countdown % 60;
                sendCodeBtn.textContent = `재발송 (${minutes}:${seconds.toString().padStart(2, '0')})`;

                countdown--;

                if (countdown < 0) {
                    clearInterval(timer);
                    sendCodeBtn.disabled = false;
                    sendCodeBtn.textContent = '인증번호 발송';
                }
            }, 1000);
        }
    </script>

    <%- include('../partials/header-scripts') %>
</body>
</html>